' @source: dany.md L309-311; ledger t1.4-interceptor-cron (pricing-tick.cron.ts:18); ledger t1.4-safety-5-rules (safety.py:1-19)

@startuml sd-ml-01-pricing-cron
title SD-ML-01: PricingTickCron — Chu kỳ Định giá Mỗi Giờ

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 120

participant "PricingTickCron\n(NestJS Schedule)\ncron: \"0 * * * *\"\n[pricing-tick.cron.ts:18]" as Cron
participant "DynamicPricingService" as DPSvc
database "MongoDB" as DB
participant "Sidecar\n/predict\n(port 8000)" as Sidecar
participant "DDQN\nSharedMLPDuelingQNet" as DDQN
participant "Safety Layer\n(safety.py)" as Safety
participant "NotificationService" as Notif
actor "Farm" as Farm

== Mỗi giờ (0 * * * *) ==

Cron -> DPSvc : runPricingTick()
DPSvc -> DB : products.find({status:'active'})\n→ lấy tất cả sản phẩm đang bán

loop Mỗi sản phẩm (batch)
    DPSvc -> DPSvc : Build state vector 9 field:\n{freshness, inventory_ratio, base_price,\ncompetitor_ref_price, days_to_restock,\nprev_delta, demand_7d, category, productId}\n[dynamic-pricing.service.ts:503-513]

    DPSvc -> Sidecar : POST /predict\n{state_vectors: [...]}
    Sidecar -> Sidecar : _build_obs()\n→ vector 10 chiều\n[main.py:286-295]
    Sidecar -> DDQN : ddqn_net(obs_t, cat_t, mask_t)\n→ Q-values (11 action)
    DDQN --> Sidecar : argmax Q → action_idx\n→ delta = CANDIDATES[action_idx]
    Sidecar -> Sidecar : target_price = base_price × (1 + delta)
    Sidecar -> Safety : apply_safety(target_price, base_price, freshness)
    Safety --> Sidecar : (final_price, safety_clipped)
    Sidecar --> DPSvc : [{productId, targetPrice, delta_pct, safety_clipped, freshness_tag}]

    DPSvc -> DB : price_overrides.insertOne({\n  productId, targetPrice, delta_pct,\n  status: 'shadow',\n  safety_clipped, freshness_tag\n})
end

DPSvc -> Notif : Gửi thông báo cho Farm\n(sản phẩm có đề xuất giá mới)
Notif -> Farm : Push notification:\n"Đề xuất giá mới sẵn sàng"

Farm -> DB : Xem PriceOverride (status: shadow/pending_review)
alt Farm chấp nhận
    Farm -> DB : price_overrides.updateOne({status:'accepted'})
    DB -> DB : product.pricePerUnit cập nhật
else Farm từ chối
    Farm -> DB : price_overrides.updateOne({status:'rejected'})
end

@enduml
