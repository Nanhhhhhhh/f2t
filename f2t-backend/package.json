    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "seed:images": "ts-node -r tsconfig-paths/register src/seed/seed-images.ts"
  },
