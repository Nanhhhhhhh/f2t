**Hình 3.5: Quan hệ giữa User và Notification**

```mermaid
erDiagram
    USER {
        ObjectId _id PK
        string firstName
        string lastName
        string pushToken "select:false"
    }
    NOTIFICATION {
        ObjectId _id PK
        ObjectId userId FK
        string type "order_placed|order_confirmed|order_preparing|order_shipped|order_delivered|order_cancelled|new_order|low_stock|system"
        string title
        string message
        boolean isRead
        string referenceId "orderId|productId"
        string referenceType "order|product|farm"
        boolean pushSent
    }
    NOTIFICATION_PREFS {
        ObjectId _id PK
        ObjectId userId FK "unique"
        boolean emailNotifications "default:true"
        boolean smsNotifications "default:true"
        boolean pushNotifications "default:true"
        boolean orderUpdates "default:true"
        boolean promotions "default:false"
        boolean newsletter "default:false"
    }
    USER ||--o{ NOTIFICATION : "nhận thông báo"
    USER ||--|| NOTIFICATION_PREFS : "có cài đặt thông báo"
```

